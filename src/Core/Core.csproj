<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared code for both test projects. No test runner in here. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Playwright" />
  </ItemGroup>

  <!-- Copied next to each test project's build, where TestSettings reads them. -->
  <ItemGroup>
    <None Update="Config\appsettings*.json" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
